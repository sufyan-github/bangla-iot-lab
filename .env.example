# Copy to .env for local development. Never commit real secrets.
DATABASE_URL=postgres://banglalab:banglalab_dev@127.0.0.1:55440/banglalab_dev
API_HOST=127.0.0.1
API_PORT=4000
# Origin of the web app allowed to call the API from a browser.
WEB_ORIGIN=http://localhost:5173
COMPILE_WORKER_URL=http://127.0.0.1:4100
# Compile worker: bwrap (default), container, or none (development only).
COMPILE_SANDBOX=bwrap
